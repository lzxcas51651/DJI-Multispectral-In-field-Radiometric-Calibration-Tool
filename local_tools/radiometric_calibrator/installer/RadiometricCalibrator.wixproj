<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>zh-CN</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.1.0</ProductVersion>
    <OutputName>DJI_Radiometric_Calibrator_$(ProductVersion)_x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <Compile Include="Package.wxs" />
    <Compile Include="generated\Payload.wxs" />
  </ItemGroup>
</Project>
